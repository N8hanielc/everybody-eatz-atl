# ─────────────────────────────────────────────────────────────
#  Everybody Eatz ATL — environment variables
#
#  1. Copy this file to a new file named  .env.local  (same folder).
#  2. Fill in the values below.
#  3. NEVER commit .env.local to GitHub (it's already in .gitignore).
#  4. On Vercel, add the same variables under
#     Project → Settings → Environment Variables.
#
#  Variables starting with NEXT_PUBLIC_ are visible in the browser —
#  only put non-secret values in them.
# ─────────────────────────────────────────────────────────────

# ── Site ──────────────────────────────────────────────────────
# Local: http://localhost:3000   Production: https://your-domain.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Currency for donations (3-letter ISO code, lowercase). Default: usd
NEXT_PUBLIC_DONATION_CURRENCY=usd

# ── Stripe (https://dashboard.stripe.com) ─────────────────────
# Use TEST-mode keys (sk_test_...) while developing.
# Where: Stripe Dashboard → Developers → API keys → "Secret key". SECRET — server only.
STRIPE_SECRET_KEY=sk_test_replace_me

# Where (local): printed by `stripe listen` (starts with whsec_).
# Where (production): Stripe Dashboard → Developers → Webhooks → your endpoint → "Signing secret".
# SECRET — server only.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional. Not required by this site (it redirects to Stripe-hosted Checkout),
# kept here in case you add client-side Stripe features later. Safe to expose.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# ── Supabase (https://supabase.com/dashboard) ─────────────────
# Where: Project → Settings → API (or "Data API") → Project URL. Not secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Where: Project → Settings → API Keys → "anon" / publishable key.
# Optional — the site does all database work on the server, but this is
# kept for convention and future use. Safe to expose (RLS blocks it).
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me

# Where: Project → Settings → API Keys → "service_role" / secret key.
# REQUIRED. SECRET — bypasses Row Level Security. Server only; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace_me
